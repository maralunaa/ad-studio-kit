# Ad Studio kit: copy to .env and fill in. Never commit .env.
# Full list with defaults: docs/ad-studio.md › Configuration.

# ── Brand pack ──────────────────────────────────────────────────────
BRAND=sample                      # folder under brands/ (or BRAND_DIR=/path/to/pack)

# ── Login ──────────────────────────────────────────────────────────
ADSTUDIO_PASSWORD=                # required when deployed
FLASK_SECRET_KEY=                 # any long random string, so logins survive restarts
ADMIN_TOKEN=                      # header token for /admin/smoke, /admin/meta-sync (cron, deploy checks)

# ── Models ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                # Claude: copy, research, QA, claims checks
CI_REPLICATE_API_KEY=             # images, video clips, voices (Replicate)
KLING_API_KEY=                    # optional: Kling direct, about half Replicate's price

# ── Meta (read-only) ───────────────────────────────────────────────
META_ACCESS_TOKEN=                # system-user token with ads_read (+ read_insights); never ads_management
META_AD_ACCOUNT_ID=               # act_...
META_API_VERSION=v19.0
META_PAGE_ID=                     # optional: import real comments from the brand's Page

# ── Store ──────────────────────────────────────────────────────────
SHOPIFY_PUBLIC_URL=               # overrides brand.yaml › store.public_url, e.g. https://shop.example.com

# ── Google Drive (launch kits, backups) ─────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADSTUDIO_DRIVE_FOLDER_ID=         # folder that receives launch kits
BACKUP_DRIVE_FOLDER_ID=           # folder that receives nightly database backups

# ── Background work ────────────────────────────────────────────────
SCHEDULER_ENABLED=0               # 1 = daily store and Meta sync, backups (turn on when deployed)
JOB_CONCURRENCY=3

# ── Optional ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                # post Admin alerts to Slack
